; Hotend calibration print, generated by yazici/calibration_print.py (temp 245, mid 150, holds [215, 185, 150],
; fan [15, 25, 40, 60, 100] %, slow ramp 1.0 C/s, holds 150 s). No extrusion, bed off, nozzle 50 mm above the
; bed centre. The twin learns from it (not experiment-marked, K79): on unchanged hardware back up and restore
; its twin_state.json.
; Estimated duration ~58 min.
SET_IDLE_TIMEOUT TIMEOUT=7200
M140 S0
M104 S0
G28
G90
G1 Z50 F600
G1 X117 Y117 F6000
; --- 1 cold start ---
M117 cal cold start
M106 S255
TEMPERATURE_WAIT SENSOR=extruder MAXIMUM=40
M106 S0
G4 P60000          ; calm after the fan
; --- 2 full-power ramp + 3 hold ---
M117 cal ramp 245 full power
M109 S245
G4 P180000          ; hold 245, fan 0
; --- 4 free cooling ---
M117 cal free cooling to 150
M104 S0
TEMPERATURE_WAIT SENSOR=extruder MAXIMUM=150
; --- 5 slow ramp 150 -> 245 at 1.0 C/s (target raised 1 C at a time) ---
M117 cal slow ramp 1.0C/s
